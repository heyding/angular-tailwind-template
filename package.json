{
  "name": "angular-tailwind-template",
  "version": "2.0.0",
  "description": "D-Stack Ready Angular 22 Enterprise Template with Tailwind CSS 4, NgRx 21, DSGVO compliance, and 25+ production-ready components for German government and public administration",
  "keywords": [
    "angular",
    "angular-22",
    "d-stack",
    "dstack",
    "deutschland-stack",
    "tailwind",
    "tailwindcss",
    "ngrx",
    "typescript",
    "enterprise-template",
    "dsgvo",
    "gdpr",
    "angular-template",
    "starter-template",
    "government",
    "public-administration",
    "dark-mode",
    "i18n",
    "authentication",
    "state-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/heyding/angular-tailwind-template.git"
  },
  "homepage": "https://github.com/heyding/angular-tailwind-template#readme",
  "bugs": {
    "url": "https://github.com/heyding/angular-tailwind-template/issues"
  },
  "author": "Tommy Heyding",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ci": "ng build --base-href /",
    "build:gh-pages": "ng build --base-href /angular-tailwind-template/",
    "openapi:generate": "ng-openapi-gen --config ng-openapi-gen.json",
    "openapi:clean": "rm -rf src/app/core/api/generated",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- src/app/core/api/generated",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --reporter=list,html",
    "lhci": "npm run build:ci && lhci autorun",
    "quality": "npm run e2e:ci && npm run lhci",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.1",
    "@angular/cdk": "^22.0.1",
    "@angular/common": "^22.0.2",
    "@angular/core": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@angular/platform-browser-dynamic": "^22.0.1",
    "@angular/router": "^22.0.1",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/schematics": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "ngrx-store-localstorage": "^20.1.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.53.2",
    "@angular-devkit/build-angular": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.1",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^22.10.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "husky": "^9.1.7",
    "http-server": "^14.1.1",
    "jasmine-core": "^5.5.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^16.2.7",
    "ng-openapi-gen": "^1.0.3",
    "postcss": "^8.5.18",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.{scss,css}": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
